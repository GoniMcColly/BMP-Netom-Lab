      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom-netom"
          },
          "refId": "A",
          "expr": "sum(rate(netom_bmp_state_num_announcements_total{component=\"bmp-in\"}[10s])) or vector(0)",
