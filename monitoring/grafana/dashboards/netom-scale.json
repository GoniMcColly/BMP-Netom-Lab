    {
      "type": "row",
      "id": 8,
      "title": "Late joiner: a new consumer gets the full table from netom, not from the routers",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "Paths held: collector vs. consumers",
      "description": "When a consumer starts, its line climbs to the collector's line. Every path it gets comes from netom's RIB; the routers send nothing extra.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-netom"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 16,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom-netom"
          },
          "refId": "A",
          "expr": "netom_rib_unit_num_items_total{component=\"rib\"}",
          "legendFormat": "collector (netom)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom-netom"
          },
          "refId": "B",
          "expr": "netom_rib_unit_num_items_total{component=\"consumer-rib\"}",
          "legendFormat": "consumer 1"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom-netom"
          },
          "refId": "C",
          "expr": "netom_rib_unit_num_items_total{component=\"consumer2-rib\"}",
          "legendFormat": "consumer 2"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 3,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "collector (netom)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "consumer 1"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "consumer 2"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "stat",
      "id": 10,
      "title": "Consumer 1: paths vs. netom",
      "description": "Paths the consumer has stored, as a share of netom's. netom's count includes withdrawn records, so a consumer that joins during churn shows slightly less until those prefixes are announced again.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-netom"
      },
      "gridPos": {
        "x": 16,
        "y": 6,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom-netom"
          },
          "refId": "A",
          "expr": "100 * netom_rib_unit_num_items_total{component=\"consumer-rib\"} / on() netom_rib_unit_num_items_total{component=\"rib\"}",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          },
          "decimals": 1,
          "noValue": "not running"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "wideLayout": true
      }
    },
