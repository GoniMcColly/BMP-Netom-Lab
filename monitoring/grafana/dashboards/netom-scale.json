    {
      "type": "stat",
      "id": 7,
      "title": "netom memory",
      "description": "Working set of the netom container (cAdvisor).",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-netom"
      },
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
