        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "center",
        "wideLayout": true
      }
    },
    {
      "type": "stat",
      "id": 6,
      "title": "Ingest rate",
      "description": "Prefix announcements per second parsed from all BMP sessions (10 s window).",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-netom"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
