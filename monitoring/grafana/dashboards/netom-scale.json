    {
      "type": "table",
      "id": 17,
      "title": "Per router: prefixes and sessions (sysName from netom's API)",
      "description": "Prometheus labels routers by netom's ingress id; the netom API (Infinity) supplies the sysName.",
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom-netom"
          },
          "refId": "A",
          "expr": "netom_bmp_state_num_received_prefixes_total{component=\"bmp-in\"}",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom-netom"
          },
