{
  "uid": "netom-scale",
  "title": "netom at scale",
  "tags": [
    "bmp",
    "netom"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "2s",
  "time": {
    "from": "now-10m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1s",
      "2s",
      "5s",
      "10s",
      "30s"
    ]
  },
  "description": "Scale demo: how many routers and paths netom holds, how fast it ingests, and how fast a new consumer gets the full table.",
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "The whole network in one collector",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "id": 2,
      "title": "BMP routers streaming",
      "description": "Routers with an open BMP session to netom (one TCP session each).",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-netom"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom-netom"
          },
          "refId": "A",
          "expr": "netom_bmp_num_connected_routers_total{component=\"bmp-in\"}",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "center",
        "wideLayout": true
      }
    },
    {
      "type": "stat",
      "id": 3,
      "title": "BGP sessions monitored",
      "description": "BGP sessions in state Up, summed over all routers. Each one is a peer whose Adj-RIB-In netom receives.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-netom"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom-netom"
          },
          "refId": "A",
          "expr": "sum(netom_bmp_state_num_up_peers_total{component=\"bmp-in\"})",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "center",
        "wideLayout": true
      }
    },
    {
      "type": "stat",
      "id": 4,
      "title": "Paths in netom",
      "description": "RIB records in the collector: one per prefix per peer view (pre- and post-policy count separately). Includes records that were withdrawn.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-netom"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom-netom"
          },
          "refId": "A",
          "expr": "netom_rib_unit_num_items_total{component=\"rib\"}",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
